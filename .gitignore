node_modules/
dist/
.env
.env.local
*.local

# Study data exports
study_data_*.json

# OS
.DS_Store
Thumbs.db
api_key.txt

# Synthetic pilot cohort — regenerate deterministically with
#   npx tsx sim/pilot-run.mts --participants=24
# The exports are ~3 MB each; the generated report and summary are committed instead.
logs/Pilots/auto/study_P-SIM*.json
logs/Pilots/auto/figs/

# Python bytecode from the analysis scripts in scripts/
__pycache__/

# Narration pipeline working files: audio, transcripts and per-decision narration are
# identifiable data (a voice, a screen, a named person). Regenerate them, never commit them.
Results/Narration/

# Raw session recordings (screen + mic) that feed the narration pipeline above — same reason,
# same rule: identifiable data, never commit it.
Results/Recordings/

# Interview transcripts (named participants) — same reason, same rule.
Results/Interviews/

# Filled-in supplementary questionnaire responses (named participants) — same reason, same rule.
# The blank template in Forms/ has no participant data and is fine to commit.
Results/Supplements/

# Old output path for the findings page, kept as a backstop. It now builds to
# Results/findings_synthesis.html, which is committed on purpose -- see docs/reports/README.md.
docs/reports/findings_synthesis.html

# The name<->anon-ID key. The ONLY place real names live -- never commit or push it.
docs/Participants.xlsx
docs/~$*.xlsx

# Demo clips cut from the session recordings for the findings review page (scripts/register/build_demos.py) —
# same reason as Results/Recordings/: they show a participant's own session.
Results/review_media/

# Clips and stills cut from participants' own sessions for the presentation folder -- same reason as
# Results/Recordings/: identifiable data, never commit it.
presentation/04_study_recordings/

# Paper drafts: LaTeX build files, and the zips (each duplicates its PaperDrafting/vN folder).
PaperDrafting/**/*.aux
PaperDrafting/**/*.bbl
PaperDrafting/**/*.blg
PaperDrafting/**/*.fdb_latexmk
PaperDrafting/**/*.fls
PaperDrafting/**/*.log
PaperDrafting/**/*.out
PaperDrafting/**/main*.zip
PaperDrafting/ScopeOfAutonomy_v*.zip

# The review server's automatic backup of responses.json (rewritten on every save)
docs/analysis/register/responses.bak.json
