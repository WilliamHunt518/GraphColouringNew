@misc{barba_dynamic_2018,
	title = {Dynamic Graph Coloring},
	url = {http://arxiv.org/abs/1708.09080},
	doi = {10.48550/arXiv.1708.09080},
	abstract = {In this paper we study the number of vertex recolorings that an algorithm needs to perform in order to maintain a proper coloring of a graph under insertion and deletion of vertices and edges. We present two algorithms that achieve different trade-offs between the number of recolorings and the number of colors used. For any \$d{\textgreater}0\$, the first algorithm maintains a proper \$O({\textbackslash}mathcal\{C\} d N{\textasciicircum}\{1/d\})\$-coloring while recoloring at most \$O(d)\$ vertices per update, where \${\textbackslash}mathcal\{C\}\$ and \$N\$ are the maximum chromatic number and maximum number of vertices, respectively. The second algorithm reverses the trade-off, maintaining an \$O({\textbackslash}mathcal\{C\} d)\$-coloring with \$O(d N{\textasciicircum}\{1/d\})\$ recolorings per update. The two converge when \$d = {\textbackslash}log N\$, maintaining an \$O({\textbackslash}mathcal\{C\} {\textbackslash}log N)\$-coloring with \$O({\textbackslash}log N)\$ recolorings per update. We also present a lower bound, showing that any algorithm that maintains a \$c\$-coloring of a \$2\$-colorable graph on \$N\$ vertices must recolor at least \$Ω(N{\textasciicircum}{\textbackslash}frac\{2\}\{c(c-1)\})\$ vertices per update, for any constant \$c {\textbackslash}geq 2\$.},
	number = {{arXiv}:1708.09080},
	publisher = {{arXiv}},
	author = {Barba, Luis and Cardinal, Jean and Korman, Matias and Langerman, Stefan and Renssen, André van and Roeloffzen, Marcel and Verdonschot, Sander},
	urldate = {2026-04-27},
	date = {2018-06-25},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {1708.09080 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms},
	file = {PDF:C\:\\Users\\Work\\Zotero\\storage\\P8V2TVYU\\Barba et al. - 2018 - Dynamic Graph Coloring.pdf:application/pdf},
}

